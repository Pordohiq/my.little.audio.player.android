<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/activeParent"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="150dp"
	android:background="@color/middleGrey">
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="75dp"
		android:layout_gravity="center"
		android:fillViewport="true">
		<TextView
			android:id="@+id/playing_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/none"
			android:textSize="26sp"
			android:gravity="center"
			android:textAlignment="center"
			android:textColor="@color/lightGrey">
			
		</TextView>
	</ScrollView>
	<View
		android:layout_width="match_parent"
		android:layout_height="25dp"
		android:background="@color/darkGrey"></View>
	
	<!-- Bottom row -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:orientation="horizontal">
		
		<!-- PB_Button -->
		<LinearLayout
			android:layout_width="150dp"
			android:layout_height="50dp"
			android:orientation="horizontal"
			android:layout_weight="0">
			<ImageView
				android:id="@+id/previousButton"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:src="@drawable/active_pb_previous" />
			<ImageView
				android:id="@+id/playButton"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:src="@drawable/active_pb_play" />
			<ImageView
				android:id="@+id/nextButton"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:src="@drawable/active_pb_next" />
		</LinearLayout>
		
		<View
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_weight="1"/>
		<LinearLayout
			android:layout_width="150dp"
			android:layout_height="50dp"
			android:orientation="horizontal"
			android:layout_weight="0">
		
		</LinearLayout>
	</LinearLayout>
	
</LinearLayout>